import pytest
import numpy as np
from p4 import euler_ode

def test_euler_edge_cases():
    f = lambda x, y: y
    with pytest.raises(ValueError, match="Số bước chia n phải là số nguyên dương"):
        euler_ode(f, 0, 1, 1, 0)
    with pytest.raises(ValueError, match="Đầu mút khoảng.*không hợp lệ"):
        euler_ode(f, 2, 0, 1, 10)

def test_euler_basic():
    f = lambda x, y: y - x**2 + 1
    exact_y_at_2 = (2 + 1)**2 - 0.5 * np.exp(2)
    
    xs, ys = euler_ode(f, 0, 2, 0.5, 10)
    
    assert len(xs) == 11
    assert len(ys) == 11
    assert np.isclose(ys[-1], exact_y_at_2, atol=0.6)

def test_euler_convergence_order():
    f = lambda x, y: y
    exact_val = np.exp(1.0)
    
    _, ys_10 = euler_ode(f, 0, 1, 1.0, 10)
    _, ys_100 = euler_ode(f, 0, 1, 1.0, 100)
    
    ratio = abs(exact_val - ys_10[-1]) / abs(exact_val - ys_100[-1])
    assert 8 < ratio < 12
